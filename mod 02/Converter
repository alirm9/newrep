talents = float(input("Enter talents: "))
pounds = float(input("Enter pounds: "))
lots = float(input("Enter lots: "))

# Convert everything down to lots first
total_lots = (talents * 20 * 32) + (pounds * 32) + lots

# Convert total lots to total grams
total_grams = total_lots * 13.3

# Extract full kilograms and remaining grams
kilograms = int(total_grams // 1000)
remaining_grams = total_grams % 1000

print("\nThe weight in modern units:")
print(f"{kilograms} kilograms and {remaining_grams:.2f} grams.")